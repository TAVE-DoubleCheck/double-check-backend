# 이 파일을 .env로 복사해서 사용 (.env는 Git에 올리지 않음)
POSTGRES_DB=insurance
POSTGRES_USER=insurance
POSTGRES_PASSWORD=insurance
# 로컬에 이미 PostgreSQL이 5432를 쓰고 있으면 5433 등으로 변경
POSTGRES_PORT=5432

# 공공데이터포털 인증키 (코드 호출용 = Decoding 키)
DATA_GO_KR_SERVICE_KEY=

# 로그인 (JWT). 서명 키는 32자 이상. 줄을 주석으로 두면 개발용 기본값 사용
# (빈 값 "JWT_SECRET="으로 두면 빈 키가 들어가 기동 실패하니 쓰지 않을 땐 # 그대로 둘 것)
# JWT_SECRET=
# 기동 시 자동 생성되는 직원 계정 (주석이면 admin@doublecheck.local / admin1234!)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
